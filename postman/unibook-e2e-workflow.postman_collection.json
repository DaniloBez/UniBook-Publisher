    {
      "name": "10. Author gets contract (polling)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const attempt = parseInt(pm.collectionVariables.get('contractAttempt') || '0', 10);\nif (attempt > 0) {\n    const end = Date.now() + 1000;\n    while (Date.now() < end) { /* busy wait */ }\n}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const MAX_ATTEMPTS = 15;\nconst attempt = parseInt(pm.collectionVariables.get('contractAttempt') || '0', 10) + 1;\npm.collectionVariables.set('contractAttempt', String(attempt));\n\npm.test('Status is 200 OK (attempt ' + attempt + ')', function () {\n    pm.response.to.have.status(200);\n});\n\nlet contractId = '';\ntry {\n    const body = pm.response.json();\n    const contract = Array.isArray(body) ? body[0] : body;\n    contractId = (contract && contract.contract_id) || '';\n} catch (e) {\n    contractId = '';\n}\n\nif (contractId) {\n    pm.collectionVariables.set('contractId', contractId);\n    pm.test('contract_id is not empty', function () {\n        pm.expect(contractId).to.be.a('string').and.not.empty;\n    });\n} else if (attempt < MAX_ATTEMPTS) {\n    postman.setNextRequest('10. Author gets contract (polling)');\n} else {\n    pm.test('contract_id found within ' + MAX_ATTEMPTS + ' attempts', function () {\n        pm.expect.fail('Contract was not created in time');\n    });\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorToken}}",
