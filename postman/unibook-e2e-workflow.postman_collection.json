              "});",
              "const body = pm.response.json();",
              "pm.test('chapter_id is not empty', function () {",
              "    pm.expect(body.chapter_id).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('chapter_title is correct', function () {",
              "    pm.expect(body.chapter_title).to.eql('Chapter 1. The Beginning');",
              "});",
              "pm.test('chapter_index is 1', function () {",
