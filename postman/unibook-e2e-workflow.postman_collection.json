{
  "info": {
    "name": "UniBook Publisher - E2E Workflow",
    "description": "End-to-end workflow: author submits -> chief editor approves + assigns editor -> author adds and updates chapter -> editor finalizes text -> chief editor assigns designer -> designer uploads cover -> chief editor publishes -> author gets contract (polling) -> author verifies contract.\n\nRun with Newman from the folder that contains cover.png (a 1x1 PNG):\n  newman run unibook-e2e-workflow.postman_collection.json --working-dir .\n\nCreate cover.png with:\n  echo 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==' | base64 -d > cover.png\n\nOverride the base URL with: --env-var baseUrl=http://host:port",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "genreId",
      "value": ""
    },
    {
      "key": "manuscriptId",
      "value": ""
    },
    {
      "key": "chapterId",
      "value": ""
    },
    {
      "key": "contractId",
      "value": ""
    },
    {
      "key": "contractAttempt",
      "value": "0"
    },
    {
      "key": "password",
      "value": "SuperSecretPassword123!"
    },
    {
      "key": "chiefEditorEmail",
      "value": "chief.editor@unibook-demo.local"
    },
    {
      "key": "chiefEditorToken",
      "value": ""
    },
    {
      "key": "chiefEditorId",
      "value": ""
    },
    {
      "key": "editorEmail",
      "value": "editor@unibook-demo.local"
    },
    {
      "key": "editorToken",
      "value": ""
    },
    {
      "key": "editorId",
      "value": ""
    },
    {
      "key": "designerEmail",
      "value": "designer@unibook-demo.local"
    },
    {
      "key": "designerToken",
      "value": ""
    },
    {
      "key": "designerId",
      "value": ""
    },
    {
      "key": "authorEmail",
      "value": "author1@unibook-demo.local"
    },
    {
      "key": "authorToken",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "accountantEmail",
      "value": "accountant@unibook-demo.local"
    },
    {
      "key": "accountantToken",
      "value": ""
    },
    {
      "key": "accountantId",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "authorRefreshToken",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique timestamp once per run so the collection can be re-run safely",
          "if (!pm.collectionVariables.get('ts')) {",
          "    pm.collectionVariables.set('ts', String(Date.now()));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as chiefEditor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{chiefEditorEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('access_token and refresh_token are returned', function () {",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.expires_in).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('chiefEditorToken', body.access_token);",
                  "pm.collectionVariables.set('chiefEditorId', body.user_id);"
                ]
              }
            }
          ]
        },
