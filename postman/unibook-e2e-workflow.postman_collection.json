        {
          "name": "Request without token is rejected (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "genres"
