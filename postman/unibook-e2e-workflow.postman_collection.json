    {
      "name": "0. Create genre",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"genreName\": \"E2E Genre {{ts}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/genres",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "genres"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{chiefEditorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.test('genre_id is not empty', function () {",
              "    pm.expect(body.genre_id).to.be.a('string').and.not.empty;",
              "});",
              "// Save genre id for the next step",
              "pm.collectionVariables.set('genreId', body.genre_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Author submits manuscript",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"E2E Manuscript {{ts}}\",\n  \"annotation\": \"Integration test manuscript\",\n  \"draft_file_url\": \"https://storage.example.com/drafts/e2e-{{ts}}.docx\",\n  \"genre_ids\": [\"{{genreId}}\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/manuscripts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "manuscripts"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('manuscript_id is not empty', function () {",
              "    pm.expect(body.manuscript_id).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('status is SUBMITTED', function () {",
              "    pm.expect(body.status).to.eql('SUBMITTED');",
              "});",
              "pm.test('author_id matches the author', function () {",
              "    pm.expect(body.author_id).to.eql(pm.collectionVariables.get('authorId'));",
              "});",
              "// Save manuscript id for all following steps",
              "pm.collectionVariables.set('manuscriptId', body.manuscript_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Chief editor approves manuscript",
      "request": {
