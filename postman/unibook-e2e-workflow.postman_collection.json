        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('version_number is 1', function () {",
              "    pm.expect(String(body.version_number)).to.eql('1');",
              "});",
              "pm.test('uploaded_by_user_id matches the designer', function () {",
              "    pm.expect(body.uploaded_by_user_id).to.eql(pm.collectionVariables.get('designerId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Chief editor publishes manuscript",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/manuscripts/{{manuscriptId}}/publish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "manuscripts",
            "{{manuscriptId}}",
            "publish"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{chiefEditorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('status is PUBLISHED', function () {",
              "    pm.expect(pm.response.json().status).to.eql('PUBLISHED');",
              "});",
              "// Reset the polling state before the contract lookup step",
              "pm.collectionVariables.set('contractAttempt', '0');",
              "pm.collectionVariables.set('contractId', '');"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Author gets contract (polling)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/contracts?manuscriptId={{manuscriptId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "contracts"
          ],
          "query": [
            {
              "key": "manuscriptId",
              "value": "{{manuscriptId}}"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const attempt = parseInt(pm.collectionVariables.get('contractAttempt') || '0', 10);",
              "if (attempt > 0) {",
              "    const end = Date.now() + 1000;",
              "    while (Date.now() < end) { /* busy wait */ }",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const MAX_ATTEMPTS = 15;",
              "const attempt = parseInt(pm.collectionVariables.get('contractAttempt') || '0', 10) + 1;",
              "pm.collectionVariables.set('contractAttempt', String(attempt));",
              "",
              "pm.test('Status is 200 OK (attempt ' + attempt + ')', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let contractId = '';",
              "try {",
              "    const body = pm.response.json();",
              "    const contract = Array.isArray(body) ? body[0] : body;",
              "    contractId = (contract && contract.contract_id) || '';",
              "} catch (e) {",
              "    contractId = '';",
              "}",
              "",
              "if (contractId) {",
              "    // Contract found: store it and continue with the next request",
              "    pm.collectionVariables.set('contractId', contractId);",
              "    pm.test('contract_id is not empty', function () {",
              "        pm.expect(contractId).to.be.a('string').and.not.empty;",
              "    });",
              "} else if (attempt < MAX_ATTEMPTS) {",
              "    // Contract not created yet: run this same request again",
              "    postman.setNextRequest('9. Author gets contract (polling)');",
              "} else {",
              "    // Out of attempts: fail the run explicitly",
              "    pm.test('contract_id found within ' + MAX_ATTEMPTS + ' attempts', function () {",
              "        pm.expect.fail('Contract was not created in time');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Author fetches contract",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/contracts/{{contractId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "contracts",
            "{{contractId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "// Verify the contract belongs to this manuscript and author",
              "pm.test('contract.manuscript_id matches the manuscript', function () {",
              "    pm.expect(body.manuscript_id).to.eql(pm.collectionVariables.get('manuscriptId'));",
              "});",
              "pm.test('contract.author_id matches the author', function () {",
              "    pm.expect(body.author_id).to.eql(pm.collectionVariables.get('authorId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Security checks",
      "item": [
        {
          "name": "Author cannot approve manuscript (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"editor_id\": \"{{editorId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manuscripts/{{manuscriptId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "manuscripts",
                "{{manuscriptId}}",
                "approve"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Logout author",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authorToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204 No Content', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
